{
  "name": "Khmer Letter Pad",
  "short_name": "Letter Pad",
  "description": "Draw the Khmer alphabet with fun brushes and turn it into your own font.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f6f3ff",
